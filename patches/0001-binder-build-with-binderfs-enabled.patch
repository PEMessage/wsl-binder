From 6c317d46f59f13d99fe0580942098f25b22416c6 Mon Sep 17 00:00:00 2001
From: p <p@example.com>
Date: Mon, 9 Nov 2026 15:35:15 +0800
Subject: [PATCH 1/2] binder: build with binderfs enabled

CONFIG_ANDROID_BINDERFS must be 1 for IS_ENABLED(); the quoted y evaluates
to false, so binder_init() still registers the legacy misc devices
(/dev/binder, ...) next to binderfs.
---
 binder/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/binder/Makefile b/binder/Makefile
index ee0d72b..9d0e522 100644
--- a/binder/Makefile
+++ b/binder/Makefile
@@ -1,4 +1,4 @@
-ccflags-y += -I$(src) -Wno-int-conversion -DCONFIG_ANDROID_BINDER_DEVICES="\"binder\"" -DCONFIG_ANDROID_BINDERFS="y"
+ccflags-y += -I$(src) -Wno-int-conversion -DCONFIG_ANDROID_BINDER_DEVICES="\"binder\"" -DCONFIG_ANDROID_BINDERFS=1
 obj-m := binder_linux.o
 binder_linux-y := deps.o binder.o binder_alloc.o binderfs.o
 
